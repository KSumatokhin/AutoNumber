<Window x:Class="AutoNumber.NumberingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Нумерация атрибутов"
        Width="430" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8" Foreground="#20262D"
        FontFamily="Segoe UI" FontSize="12"
        ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ResourceDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Нумерация атрибутов" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Margin="0,5,0,0" Foreground="#65717C" TextWrapping="Wrap">
                <Run Text="Блок: "/><Run Text="{Binding BlockName}" FontWeight="SemiBold" Foreground="#20262D"/>
            </TextBlock>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
                <TextBlock Text="Атрибут" Style="{StaticResource CaptionText}"/>
                <ComboBox ItemsSource="{Binding AvailableTags}" Text="{Binding TagName, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                <TextBlock Text="Начальный номер" Style="{StaticResource CaptionText}"/>
                <TextBox x:Name="StartNumberBox" Text="{Binding StartNumber, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                <TextBlock Text="Шаг" Style="{StaticResource CaptionText}"/>
                <TextBox x:Name="IncrementBox" Text="{Binding Increment, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Префикс" Style="{StaticResource CaptionText}"/>
                <TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Суффикс" Style="{StaticResource CaptionText}"/>
                <TextBox Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>

        <GroupBox Grid.Row="3" Header="Область обработки" Margin="0,0,0,12">
            <StackPanel>

                <RadioButton Content="Все листы" IsChecked="{Binding IsAllLayouts}" Margin="0,8,0,0"/>
                <RadioButton Content="Выбрать объекты после закрытия окна" IsChecked="{Binding IsSelectedObjects}" Margin="0,9,0,0"/>
                <CheckBox Content="Включить пространство модели"
                          IsChecked="{Binding IncludeModelSpace}"
                          IsEnabled="{Binding IsAllLayouts}"
                          Margin="24,9,0,0"/>
                <TextBlock Text="Порядок: по листам, сверху вниз и слева направо."
                           Foreground="#65717C" Margin="0,12,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="ErrorText" Foreground="Firebrick"
                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
            <Button Grid.Column="1" Content="Отмена" IsCancel="True"
                    Click="CancelButton_Click"/>
            <Button Grid.Column="2" Content="Нумеровать" IsDefault="True"
                    Click="OkButton_Click" Margin="10,0,0,0"/>
        </Grid>
        <Button Grid.Row="5" Content="Ведомость чертежей"
                Click="ScheduleButton_Click" Margin="0,12,0,0"
                HorizontalAlignment="Stretch"
                ToolTip="Сформировать ведомость по блокам Штамп"/>
    </Grid>
</Window>
